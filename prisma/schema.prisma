// Laptop Clinic CRM — Prisma schema
// One schema, grouped by module (see blueprint §11). No hard deletes:
// records are switched off with `isActive` instead.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Organisation: company → branch, domain → department ─────────────────────

model Company {
  id        String   @id @default(cuid())
  code      String   @unique // "NTL"
  name      String
  gstin     String?
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  branches Branch[]
  users    User[]
  isDelete Int      @default(0) // 0 = active, 1 = soft-deleted

  @@map("company")
}

enum BranchType {
  COMPANY_OWNED
  FRANCHISE
}

model Branch {
  id               String     @id @default(cuid())
  companyId        String
  code             String     @unique // "EDP" — used in jobsheet numbers
  name             String // "Edappally"
  phone            String?
  address          String?
  // Virtual branches (e.g. the chip-level lab) hold stock/jobs but no counter.
  isVirtual        Boolean    @default(false)
  // Company-owned branches keep 100% (10000 bp); a franchise splits revenue and
  // settlements between the company and the franchise owner. Basis points: 6000 = 60%.
  branchType       BranchType @default(COMPANY_OWNED)
  companyShareBp   Int        @default(10000)
  franchiseShareBp Int        @default(0)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now()) @db.Timestamptz
  updatedAt        DateTime   @updatedAt @db.Timestamptz

  company   Company    @relation(fields: [companyId], references: [id])
  users     User[]
  cases     Case[]
  payments  Payment[]
  customers Customer[]
  caseInvoices CaseInvoice[]
  journalLines JournalLine[]

  stockItems       StockItem[]
  purchaseRequests PurchaseRequest[]
  purchaseBills    PurchaseBill[]
  vendorReplacements VendorReplacement[]
  stockUnits       StockUnit[]       @relation("UnitLocation")
  unitsAllocated   StockUnit[]       @relation("UnitAllocatedBranch")
  unitEvents       StockUnitEvent[]  @relation("UnitEventBranch")
  transfersOut     StockTransfer[]   @relation("TransferFrom")
  transfersIn      StockTransfer[]   @relation("TransferTo")

  directSales    DirectSale[]
  buybackRecords BuybackRecord[]
  refurbItems    RefurbItem[]
  salesTargets   SalesTarget[]
  isDelete       Int             @default(0) // 0 = active, 1 = soft-deleted

  @@index([companyId])
  @@map("branch")
}

model Domain {
  id        String   @id @default(cuid())
  code      String   @unique // "SALES"
  name      String // "Sales"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  departments Department[]
  users       User[]
  isDelete    Int          @default(0) // 0 = active, 1 = soft-deleted

  @@map("domain")
}

model Department {
  id        String   @id @default(cuid())
  domainId  String
  name      String // "Sales Team"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  domain   Domain @relation(fields: [domainId], references: [id])
  users    User[]
  isDelete Int    @default(0) // 0 = active, 1 = soft-deleted

  @@unique([domainId, name])
  @@map("department")
}

// ─── Access: privilege (role) → permissions on menu items ────────────────────

model Privilege {
  id            String   @id @default(cuid())
  code          String   @unique // ADMIN, BRANCH_MANAGER, SALES …
  name          String
  description   String?
  // Super-admin privileges see every active module and menu without permission rows.
  isSuperAdmin  Boolean  @default(false)
  // Branch-bound privileges only ever see their own branch's data.
  isBranchBound Boolean  @default(true)
  // Landing page after login when the user has no default module.
  homePath      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  users       User[]
  permissions PrivilegePermission[]
  isDelete    Int                   @default(0) // 0 = active, 1 = soft-deleted

  @@map("privilege")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentStatus {
  WORKING
  ON_LEAVE
  RESIGNED
  TERMINATED
}

model User {
  id               String           @id @default(cuid())
  userCode         String           @unique // "LC00001"
  firstName        String
  lastName         String?
  mobile           String           @unique
  email            String           @unique
  username         String           @unique
  passwordHash     String
  dob              DateTime?        @db.Date
  gender           Gender?
  maritalStatus    MaritalStatus?
  state            String?
  district         String?
  address          String?
  imageUrl         String?
  joiningDate      DateTime?        @db.Date
  status           EmploymentStatus @default(WORKING)
  twoFactorEnabled Boolean          @default(false)
  // Locked by an administrator (unlock from the Users screen).
  isLocked         Boolean          @default(false)
  // Automatic lockout after too many failed sign-ins (limits come from Rules).
  failedLoginCount Int              @default(0)
  lockedUntil      DateTime?        @db.Timestamptz
  lastLoginAt      DateTime?        @db.Timestamptz
  isActive         Boolean          @default(true)

  companyId       String
  branchId        String?
  domainId        String
  departmentId    String
  privilegeId     String
  defaultModuleId String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  company       Company           @relation(fields: [companyId], references: [id])
  branch        Branch?           @relation(fields: [branchId], references: [id])
  domain        Domain            @relation(fields: [domainId], references: [id])
  department    Department        @relation(fields: [departmentId], references: [id])
  privilege     Privilege         @relation(fields: [privilegeId], references: [id])
  defaultModule Module?           @relation(fields: [defaultModuleId], references: [id])
  createdBy     User?             @relation("UserCreatedBy", fields: [createdById], references: [id])
  created       User[]            @relation("UserCreatedBy")
  activity      UserActivityLog[]
  blockedIps    BlockedIp[]
  rulesUpdated  Rule[]

  customersCreated   Customer[]          @relation("CustomerCreatedBy")
  customersUpdated   Customer[]          @relation("CustomerUpdatedBy")
  customersConverted Customer[]          @relation("CustomerConvertedBy")
  casesCreated       Case[]              @relation("CaseCreatedBy")
  casesUpdated       Case[]              @relation("CaseUpdatedBy")
  casesAssigned      Case[]              @relation("CaseEngineer")
  caseStatusMoves    CaseStatusHistory[]
  caseAttachments    CaseAttachment[]
  caseItemReturns    CaseItemReturn[]
  returnsReviewed    CaseItemReturn[]    @relation("ReturnReviewedBy")
  paymentsReceived   Payment[]
  itemsCreated       Item[]              @relation("ItemCreatedBy")
  itemsUpdated       Item[]              @relation("ItemUpdatedBy")
  caseItemsAdded     CaseItem[]          @relation("CaseItemAddedBy")
  caseItemsRemoved   CaseItem[]          @relation("CaseItemRemovedBy")
  whatsappMessages   WhatsAppMessage[]

  caseFeedbacks     CaseFeedback[]
  tatConfigsCreated TatConfig[]    @relation("TatConfigCreatedBy")
  tatConfigsUpdated TatConfig[]    @relation("TatConfigUpdatedBy")

  stockItemsUpdated        StockItem[]           @relation("StockItemUpdatedBy")
  purchaseRequestsRaised   PurchaseRequest[]     @relation("PRRequestedBy")
  purchaseRequestsReviewed PurchaseRequest[]     @relation("PRReviewedBy")
  purchaseBillsCreated     PurchaseBill[]        @relation("BillCreatedBy")
  stockUnitsAllocated      StockUnit[]           @relation("UnitAllocatedBy")
  stockUnitsReceived       StockUnit[]           @relation("UnitReceivedBy")
  stockUnitsConsumed       StockUnit[]           @relation("UnitConsumedBy")
  inventoryConfigsUpdated  InventoryConfig[]     @relation("InventoryConfigUpdatedBy")
  caseItemUsages           CaseItemUsage[]       @relation("CaseItemUsageBy")
  replacementsConfirmed    PurchaseRequest[]     @relation("PRReplacementConfirmedBy")
  stockUnitEvents          StockUnitEvent[]      @relation("UnitEventBy")
  billPaymentsRecorded     PurchaseBillPayment[] @relation("BillPaymentBy")
  transfersCreated         StockTransfer[]       @relation("TransferCreatedBy")
  transfersApproved        StockTransfer[]       @relation("TransferApprovedBy")

  directSalesSold     DirectSale[]    @relation("DirectSaleSoldBy")
  buybacksRecorded    BuybackRecord[] @relation("BuybackRecordedBy")
  salesTargetsCreated SalesTarget[]   @relation("SalesTargetCreatedBy")

  labVendorsCreated     ChipLabVendor[]        @relation("VendorCreatedBy")
  labVendorsUpdated     ChipLabVendor[]        @relation("VendorUpdatedBy")
  labOutsourcesCreated  ChipLabOutsource[]     @relation("OutsourceCreatedBy")
  labVendorPayments     ChipLabVendorPayment[] @relation("VendorPaymentBy")
  labCases              Case[]                 @relation("CaseLabEngineer")
  qcChecklistCreated    QcChecklistItem[]      @relation("QcChecklistCreatedBy")
  qcChecklistUpdated    QcChecklistItem[]      @relation("QcChecklistUpdatedBy")
  qcResponsesAnswered   CaseQcResponse[]       @relation("QcResponseAnsweredBy")
  labTransfersCompleted Case[]                 @relation("CaseLabTransferBy")
  isDelete              Int                    @default(0) // 0 = active, 1 = soft-deleted

  @@index([companyId])
  @@index([branchId])
  @@index([privilegeId])
  @@map("user")
}

// ─── Navigation: modules → groups → items ────────────────────────────────────
//
// Module  = one icon on the rail / one tile in the app switcher.
// Menu    = entries of the module sidebar. A GROUP is a collapsible heading,
//           an ITEM is a link. Items may sit directly under a module
//           (parentId = null) or inside a group.
//
// Visibility: an ITEM shows when the user's privilege has canView;
// a GROUP shows when at least one child item shows; a MODULE shows when at
// least one of its items shows. Add rows here and the UI picks them up.

enum MenuType {
  GROUP
  ITEM
}

model Module {
  id        String   @id @default(cuid())
  code      String   @unique // "service"
  title     String // "Service"
  icon      String // lucide icon name in kebab-case, e.g. "wrench"
  path      String   @unique // route prefix, e.g. "/service"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  menus        Menu[]
  defaultUsers User[]
  isDelete     Int    @default(0) // 0 = active, 1 = soft-deleted

  @@map("module")
}

model Menu {
  id        String   @id @default(cuid())
  moduleId  String
  parentId  String?
  type      MenuType @default(ITEM)
  code      String   @unique // "service.cases.all-cases"
  title     String
  icon      String? // lucide icon name, optional
  path      String?  @unique // required for ITEM, null for GROUP
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  module      Module                @relation(fields: [moduleId], references: [id])
  parent      Menu?                 @relation("MenuTree", fields: [parentId], references: [id])
  children    Menu[]                @relation("MenuTree")
  permissions PrivilegePermission[]
  isDelete    Int                   @default(0) // 0 = active, 1 = soft-deleted

  @@index([moduleId])
  @@index([parentId])
  @@map("menu")
}

model PrivilegePermission {
  id          String   @id @default(cuid())
  privilegeId String
  menuId      String
  canView     Boolean  @default(true)
  canCreate   Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  canApprove  Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  privilege Privilege @relation(fields: [privilegeId], references: [id])
  menu      Menu      @relation(fields: [menuId], references: [id])
  isDelete  Int       @default(0) // 0 = active, 1 = soft-deleted

  @@unique([privilegeId, menuId])
  @@index([menuId])
  @@map("privilege_permission")
}

// ─── Rules: business settings editable in Master Settings → Rules ───────────

enum RuleValueType {
  NUMBER
  PERCENT
  HOURS
  MINUTES
  BOOLEAN
  TEXT
}

model Rule {
  id          String        @id @default(cuid())
  code        String        @unique // "DISCOUNT_CAP_PERCENT" — read by code via getRule()
  name        String
  category    String // "Pricing", "Service TAT", "Security" …
  valueType   RuleValueType
  value       String // stored as text, parsed by valueType
  description String?
  isActive    Boolean       @default(true)
  updatedById String?
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  updatedBy User? @relation(fields: [updatedById], references: [id])
  isDelete  Int   @default(0) // 0 = active, 1 = soft-deleted

  @@index([category])
  @@map("rule")
}

// ─── Item catalog (Master Settings → Manage → Items) ─────────────────────────

enum ItemType {
  SERVICE // labour / service charge
  PART // spare part fitted in the device
  ACCESSORY // sold alongside (bag, mouse …)
}

// What a case can be billed for. Price is the list price; the lowest price
// staff may bill is price × (100 − maxDiscountPercent) / 100 (minimum selling price).
model Item {
  id                 String   @id @default(cuid())
  code               String   @unique // "SV-CLN", "KB-DELL-5518"
  name               String
  type               ItemType @default(SERVICE)
  category           String? // "Keyboard", "Display", "Cleaning" …
  brand              String?
  unit               String   @default("Nos")
  hsnSac             String? // HSN (goods) / SAC (services) code for GST invoices
  gstPercent         Int      @default(18)
  pricePaise         Int
  maxDiscountPercent Int      @default(0)
  warrantyDays       Int?
  description        String?
  isActive           Boolean  @default(true)
  createdById        String?
  updatedById        String?
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz

  createdBy User?      @relation("ItemCreatedBy", fields: [createdById], references: [id])
  updatedBy User?      @relation("ItemUpdatedBy", fields: [updatedById], references: [id])
  caseItems CaseItem[]

  stockItems        StockItem[]
  purchaseRequests  PurchaseRequest[]
  stockUnits        StockUnit[]
  purchaseBillItems PurchaseBillItem[]
  vendorReplacements VendorReplacement[]
  transferItems     StockTransferItem[]

  directSaleItems DirectSaleItem[]
  isDelete        Int              @default(0) // 0 = active, 1 = soft-deleted

  @@index([name])
  @@index([type, isActive])
  @@map("item")
}

// ─── Numbering ───────────────────────────────────────────────────────────────

// Counters behind human codes (blueprint §11). One row per key, e.g.
// "JOBSHEET:EDP:2609" or "CUSTOMER". Incremented atomically by nextSequence()
// inside the transaction that uses the number, so a rolled-back save leaves no gap.
model NumberSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz
  isDelete  Int      @default(0) // 0 = active, 1 = soft-deleted

  @@map("number_sequence")
}

// ─── Customers ───────────────────────────────────────────────────────────────

enum CustomerType {
  INDIVIDUAL
  BUSINESS // B2B account, e.g. a hotel; can be billed for other people's cases
}

// "How did you hear about us?"
enum LeadSource {
  REPEAT_CUSTOMER
  WALK_IN
  REFERRAL
  ADVERTISEMENT
  SOCIAL_MEDIA
  GOOGLE_SEARCH
  OTHER
  WEBSITE // website enquiry (leads only)
}

// One table holds both: a LEAD is an enquiry that has not become a customer yet.
// Converting flips kind to CUSTOMER on the same row, so nothing is duplicated.
enum CustomerKind {
  CUSTOMER
  LEAD
}

// Shared by every branch; the phone number is the dedupe key.
model Customer {
  id            String       @id @default(cuid())
  code          String       @unique // "CU000001"; a lead's is "LD000001" until it is converted
  kind          CustomerKind @default(CUSTOMER)
  type          CustomerType @default(INDIVIDUAL)
  name          String
  phone         String       @unique // digits only: 9847012345 or 04842401234
  altPhone      String?
  email         String?
  gstin         String?
  // B2B accounts: the person to talk to at the company.
  contactPerson String?
  address       String?
  state         String?
  district      String?
  pincode       String?
  // How they first found us; each case keeps its own source too.
  source        LeadSource?
  notes         String?
  // Lead fields. leadCode is set for every record that started as a lead (it
  // keeps the LD code after conversion); the others are null for plain customers.
  purpose       String?
  leadCode      String?      @unique
  convertedAt   DateTime?    @db.Timestamptz
  convertedById String?
  // Kept in step by case intake so lists sort without aggregating 100k rows.
  visitCount    Int          @default(0)
  lastVisitAt   DateTime?    @db.Timestamptz
  isActive      Boolean      @default(true)
  // The branch that registered the customer; branch users see their own (and customers they've serviced).
  branchId      String?
  createdById   String?
  updatedById   String?
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  branch           Branch?           @relation(fields: [branchId], references: [id])
  createdBy        User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  convertedBy      User?             @relation("CustomerConvertedBy", fields: [convertedById], references: [id])
  cases            Case[]            @relation("CaseCustomer")
  accountCases     Case[]            @relation("CaseAccount")
  payments         Payment[]
  caseInvoices     CaseInvoice[]
  whatsappMessages WhatsAppMessage[]

  directSales    DirectSale[]
  buybackRecords BuybackRecord[]
  isDelete       Int             @default(0) // 0 = active, 1 = soft-deleted

  @@index([name])
  @@index([createdAt])
  @@index([lastVisitAt])
  @@index([branchId])
  @@index([kind, createdAt])
  @@map("customer")
}

// ─── Service: cases ──────────────────────────────────────────────────────────

enum IntakeType {
  WALK_IN
  PICKUP
  ON_SITE
}

enum ProductType {
  LAPTOP
  PRINTER
  DESKTOP
  OTHER
}

enum WarrantyStatus {
  NON_WARRANTY
  WARRANTY
  RETURN
}

enum CaseStatus {
  INTAKE
  DIAGNOSIS
  PENDING_APPROVAL
  AWAITING_STOCK
  QUALITY_CHECK
  READY_FOR_DELIVERY
  CLOSED
  CANCELLED
  // Chip-Level Lab track (case keeps the same ID throughout)
  CHIP_TRANSFER // Branch sent to lab | Lab sees as "Incoming"
  CHIP_LAB_RECEIVED // Lab physically received the device
  CHIP_LAB_DIAGNOSIS // Lab running diagnosis
  CHIP_LAB_PENDING_APPROVAL // Pending customer approval on lab estimate
  CHIP_LAB_SERVICING // Device in active repair at lab
  CHIP_LAB_READY_DISPATCH // Lab repair done, ready for quality check
  CHIP_LAB_QUALITY_CHECK // Lab QC before handing back to branch
  CHIP_BRANCH_RECEIVED // Branch received device back from lab
  NON_REPAIRABLE // Cannot be repaired (reason stored in CaseStatusHistory.note)
}

enum ItemCondition {
  GOOD
  FAIR
  WORN
  DAMAGED
}

enum PaymentMode {
  UPI
  CASH
  CARD
  OTHER
  BANK_TRANSFER
}

model Case {
  id                       String         @id @default(cuid())
  jobsheetNo               String         @unique // LC-EDP-2609-0001, see modules/service/jobsheet.ts
  branchId                 String
  customerId               String
  // B2B account billed for this case (a BUSINESS customer), if any.
  accountId                String?
  intakeType               IntakeType     @default(WALK_IN)
  source                   LeadSource
  status                   CaseStatus     @default(INTAKE)
  // When the current stage began — drives the "Age" column and TAT alerts.
  stageChangedAt           DateTime       @default(now()) @db.Timestamptz
  // Pickup / on-site visits
  siteAddress              String?
  siteLatitude             Float?
  siteLongitude            Float?
  // Device
  productType              ProductType
  brand                    String
  model                    String?
  serialNo                 String?
  warrantyStatus           WarrantyStatus
  // AES-256-GCM (server/crypto.ts); every reveal is written to the activity log.
  devicePasswordEnc        String?
  problemReported          String
  // Money
  estimatedCostPaise       Int?
  gstInvoiceRequired       Boolean        @default(false)
  expectedDeliveryDate     DateTime?      @db.Date
  engineerId               String?
  labWorkType              String?
  labEngineerId            String?
  labVendorId              String?
  // Lab confirms the device was handed over to the branch (set after Transfer to Branch).
  labTransferCompletedAt   DateTime?      @db.Timestamptz
  labTransferCompletedById String?
  createdById              String?
  updatedById              String?
  createdAt                DateTime       @default(now()) @db.Timestamptz
  updatedAt                DateTime       @updatedAt @db.Timestamptz

  branch            Branch                 @relation(fields: [branchId], references: [id])
  customer          Customer               @relation("CaseCustomer", fields: [customerId], references: [id])
  account           Customer?              @relation("CaseAccount", fields: [accountId], references: [id])
  engineer          User?                  @relation("CaseEngineer", fields: [engineerId], references: [id])
  createdBy         User?                  @relation("CaseCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?                  @relation("CaseUpdatedBy", fields: [updatedById], references: [id])
  items             CaseItem[]
  receivedItems     CaseReceivedItem[]
  attachments       CaseAttachment[]
  itemReturns       CaseItemReturn[]
  stockUnits        StockUnit[]
  unitEvents        StockUnitEvent[]
  statusHistory     CaseStatusHistory[]
  payments          Payment[]
  invoice           CaseInvoice?
  whatsappMessages  WhatsAppMessage[]
  purchaseRequests  PurchaseRequest[]
  feedback          CaseFeedback?
  labOutsources     ChipLabOutsource[]
  itemUsages        CaseItemUsage[]
  vendorReplacements VendorReplacement[]
  labVendorPayments ChipLabVendorPayment[]
  labEngineer       User?                  @relation("CaseLabEngineer", fields: [labEngineerId], references: [id])
  labVendor         ChipLabVendor?         @relation("CaseLabVendor", fields: [labVendorId], references: [id])
  qcResponses       CaseQcResponse[]
  labTransferBy     User?                  @relation("CaseLabTransferBy", fields: [labTransferCompletedById], references: [id], onDelete: SetNull)
  isDelete          Int                    @default(0) // 0 = active, 1 = soft-deleted

  @@index([branchId, status, createdAt])
  @@index([branchId, stageChangedAt])
  @@index([customerId])
  @@index([accountId])
  @@index([engineerId])
  @@index([labEngineerId])
  @@index([labVendorId])
  @@map("service_case") // "case" is an SQL keyword
}

// Billable lines of a case, picked from the item catalog at diagnosis. Code,
// name and prices are copied from the item so later catalog edits don't
// rewrite the estimate. Rows are never updated or deleted: editing the
// estimate stamps removedAt on the old lines and inserts new ones.
model CaseItem {
  id              String    @id @default(cuid())
  caseId          String
  itemId          String
  code            String
  name            String
  type            ItemType
  quantity        Int       @default(1)
  listPricePaise  Int // catalog price per unit when added
  minPricePaise   Int // lowest allowed per unit when added
  unitPricePaise  Int // billed per unit
  gstPercent      Int
  lineTotalPaise  Int // unitPrice × quantity
  vendorCostPaise Int? // chip-lab outsource only: what we pay the vendor per unit
  sortOrder       Int       @default(0)
  addedById       String?
  createdAt       DateTime  @default(now()) @db.Timestamptz
  removedAt       DateTime? @db.Timestamptz
  removedById     String?

  case      Case             @relation(fields: [caseId], references: [id])
  item      Item             @relation(fields: [itemId], references: [id])
  addedBy   User?            @relation("CaseItemAddedBy", fields: [addedById], references: [id])
  removedBy User?            @relation("CaseItemRemovedBy", fields: [removedById], references: [id])
  returns   CaseItemReturn[]
  isDelete  Int              @default(0) // 0 = active, 1 = soft-deleted

  @@index([caseId, removedAt])
  @@index([itemId])
  @@map("case_item")
}

// Accessories handed over with the device (charger, bag …).
model CaseReceivedItem {
  id          String        @id @default(cuid())
  caseId      String
  name        String
  referenceNo String?
  condition   ItemCondition @default(GOOD)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz

  case     Case @relation(fields: [caseId], references: [id])
  isDelete Int  @default(0) // 0 = active, 1 = soft-deleted

  @@index([caseId])
  @@map("case_received_item")
}

model CaseAttachment {
  id                String   @id @default(cuid())
  caseId            String
  kind              String   @default("INTAKE_PHOTO")
  url               String
  fileName          String
  sizeBytes         Int
  createdById       String?
  returnId          String?
  purchaseRequestId String?
  stockUnitId       String? // photo of the stock unit, added by the Purchase Manager when allocating it
  createdAt         DateTime @default(now()) @db.Timestamptz

  case            Case             @relation(fields: [caseId], references: [id])
  stockUnit       StockUnit?       @relation(fields: [stockUnitId], references: [id])
  createdBy       User?            @relation(fields: [createdById], references: [id])
  itemReturn      CaseItemReturn?  @relation(fields: [returnId], references: [id])
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  isDelete        Int              @default(0) // 0 = active, 1 = soft-deleted

  @@index([caseId])
  @@index([returnId])
  @@index([purchaseRequestId])
  @@index([stockUnitId])
  @@map("case_attachment")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

// A part/accessory returned after the case was closed: mandatory notes + optional photos.
enum ReturnType {
  RETURN // customer gives the product back
  WARRANTY_CLAIM // product has a fault inside its warranty period
}

model CaseItemReturn {
  id             String       @id @default(cuid())
  caseId         String
  caseItemId     String
  returnType     ReturnType   @default(RETURN)
  notes          String
  status         ReturnStatus @default(REQUESTED)
  // Warranty claims: the end of cover (case closed + item warranty days), fixed when the claim is raised.
  warrantyEndsAt DateTime?    @db.Timestamptz
  createdById    String?
  reviewedById   String?
  reviewedAt     DateTime?    @db.Timestamptz
  createdAt      DateTime     @default(now()) @db.Timestamptz

  case        Case             @relation(fields: [caseId], references: [id])
  caseItem    CaseItem         @relation(fields: [caseItemId], references: [id])
  createdBy   User?            @relation(fields: [createdById], references: [id])
  reviewedBy  User?            @relation("ReturnReviewedBy", fields: [reviewedById], references: [id])
  attachments CaseAttachment[]
  stockUnits  StockUnit[]
  isDelete    Int              @default(0) // 0 = active, 1 = soft-deleted

  @@index([caseId])
  @@index([caseItemId, status])
  @@index([returnType, status])
  @@map("case_item_return")
}

// Append-only stage history; the case timeline reads from here.
model CaseStatusHistory {
  id          String      @id @default(cuid())
  caseId      String
  fromStatus  CaseStatus?
  toStatus    CaseStatus
  note        String?
  changedById String?
  at          DateTime    @default(now()) @db.Timestamptz

  case      Case  @relation(fields: [caseId], references: [id])
  changedBy User? @relation(fields: [changedById], references: [id])
  isDelete  Int   @default(0) // 0 = active, 1 = soft-deleted

  @@index([caseId, at])
  @@map("case_status_history")
}

// ─── Service: feedback ───────────────────────────────────────────────────────

enum CustomerBehaviour {
  COOPERATIVE // polite and easy to work with
  NORMAL // no notable interaction
  DIFFICULT // raised concerns / hard to please
  RUDE // abusive or disrespectful
  EXCELLENT // went out of their way to appreciate the team
}

// One-per-case feedback record, written when a case is closed.
model CaseFeedback {
  id                String            @id @default(cuid())
  caseId            String            @unique
  rating            Int // 1–5 stars
  comment           String?
  customerBehaviour CustomerBehaviour @default(NORMAL)
  createdById       String?
  createdAt         DateTime          @default(now()) @db.Timestamptz
  updatedAt         DateTime          @updatedAt @db.Timestamptz

  case      Case  @relation(fields: [caseId], references: [id])
  createdBy User? @relation(fields: [createdById], references: [id])
  isDelete  Int   @default(0) // 0 = active, 1 = soft-deleted

  @@map("case_feedback")
}

// ─── Finance ─────────────────────────────────────────────────────────────────

enum PaymentKind {
  ADVANCE
  FINAL
  OTHER
}

enum TatUnit {
  MINUTES
  HOURS
  DAYS
}

// Money received. Immutable: corrections go through refunds / adjustments.
model Payment {
  id           String      @id @default(cuid())
  branchId     String
  caseId       String?
  customerId   String
  kind         PaymentKind
  mode         PaymentMode
  amountPaise  Int
  reference    String? // UPI / card reference
  receivedById String?
  invoiceId    String? // the case invoice this payment settles (null for advances taken before billing)
  createdAt    DateTime    @default(now()) @db.Timestamptz

  branch     Branch       @relation(fields: [branchId], references: [id])
  case       Case?        @relation(fields: [caseId], references: [id])
  customer   Customer     @relation(fields: [customerId], references: [id])
  invoice    CaseInvoice? @relation(fields: [invoiceId], references: [id])
  receivedBy User?    @relation(fields: [receivedById], references: [id])
  isDelete   Int      @default(0) // 0 = active, 1 = soft-deleted

  @@index([branchId, createdAt])
  @@index([caseId])
  @@index([customerId])
  @@map("payment")
}

// TAT (Turnaround Time) targets per workflow stage. Global config — no branchId.
model TatConfig {
  id                  String     @id @default(cuid())
  status              CaseStatus @unique
  targetValue         Int // the numeric TAT (e.g. 4 for 4 hours)
  targetUnit          TatUnit    @default(HOURS)
  warningThreshold    Int        @default(80) // % of TAT elapsed at which to show warning
  escalationThreshold Int        @default(100) // % of TAT at which it becomes overdue
  isActive            Boolean    @default(true)
  remarks             String?
  createdById         String?
  updatedById         String?
  createdAt           DateTime   @default(now()) @db.Timestamptz
  updatedAt           DateTime   @updatedAt @db.Timestamptz

  createdBy User? @relation("TatConfigCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("TatConfigUpdatedBy", fields: [updatedById], references: [id])
  isDelete  Int   @default(0) // 0 = active, 1 = soft-deleted

  @@map("tat_config")
}

// ─── Security ────────────────────────────────────────────────────────────────

model BlockedIp {
  id          String   @id @default(cuid())
  ip          String   @unique
  reason      String?
  isActive    Boolean  @default(true)
  blockedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  blockedBy User? @relation(fields: [blockedById], references: [id])
  isDelete  Int   @default(0) // 0 = active, 1 = soft-deleted

  @@map("blocked_ip")
}

// Append-only: rows are inserted, never updated or deleted.
model UserActivityLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now()) @db.Timestamptz
  userId    String? // null when the username didn't match anyone
  username  String? // what was typed, for failed logins
  action    String // "login.success", "login.failed", "logout", "user.create" …
  entity    String?
  entityId  String?
  detail    String?
  ip        String?
  userAgent String?

  user     User? @relation(fields: [userId], references: [id])
  isDelete Int   @default(0) // 0 = active, 1 = soft-deleted

  @@index([userId, at])
  @@index([at])
  @@map("user_activity_log")
}

// ─── WhatsApp messaging ───────────────────────────────────────────────────────

enum WaMessageStatus {
  QUEUED
  SENT
  FAILED
}

// Append-only log of every WhatsApp template message sent from a service case.
model WhatsAppMessage {
  id            String          @id @default(cuid())
  caseId        String
  customerId    String
  templateName  String
  phone         String // E.164 recipient (e.g. +919847012345)
  payload       Json // Full request body sent to Meta
  status        WaMessageStatus @default(QUEUED)
  metaMessageId String? // wamid returned by Meta on success
  error         String?
  sentAt        DateTime?       @db.Timestamptz
  createdById   String?
  createdAt     DateTime        @default(now()) @db.Timestamptz

  case      Case     @relation(fields: [caseId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])
  isDelete  Int      @default(0) // 0 = active, 1 = soft-deleted

  @@index([caseId, createdAt])
  @@map("whatsapp_message")
}

// ─── Inventory: stock, purchasing, transfers ──────────────────────────────────

enum PurchaseRequestStatus {
  PENDING // raised, awaiting PM review
  WITH_PM // with purchase manager
  APPROVED // PM approved; awaiting arrival
  REJECTED // PM rejected
  FULFILLED // stock received at branch
  CONSUMED // legacy: now TRANSFERRED
  ORDERED // PM ordered it from the supplier; ready to transfer a USID to the branch
  TRANSFERRED // every unit allocated (transferred) to the branch case, see StockUnit
  SPARE_UNAVAILABLE // PM could not source the spare; stays on the Requests tab until ordered or rejected
}

enum TransferStatus {
  PENDING_APPROVAL // awaiting PM approval
  APPROVED // approved; ready to dispatch
  DISPATCHED // sent from source branch
  RECEIVED // received at destination
  CANCELLED // cancelled before dispatch
}

// Physical units of an item at a branch. One row per (branch, item) pair.
model StockItem {
  id          String   @id @default(cuid())
  branchId    String
  itemId      String
  quantity    Int      @default(0)
  unitCodes   String[] // individual sticker codes, e.g. ["KB123","KB124"]
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  branch    Branch @relation(fields: [branchId], references: [id])
  item      Item   @relation(fields: [itemId], references: [id])
  updatedBy User?  @relation("StockItemUpdatedBy", fields: [updatedById], references: [id])
  isDelete  Int    @default(0) // 0 = active, 1 = soft-deleted

  @@unique([branchId, itemId])
  @@index([branchId])
  @@map("stock_item")
}

// A branch requests an item from the purchase manager.
model PurchaseRequest {
  id            String                @id @default(cuid())
  code          String                @unique // "PR-EDP-2610-001"
  branchId      String
  itemId        String
  caseId        String? // case that triggered the request
  quantity      Int                   @default(1)
  notes         String?
  modelNo       String? // model number of the part (required when requested from a case)
  consumedQty   Int                   @default(0) // units allocated so far from billed stock
  status        PurchaseRequestStatus @default(PENDING)
  orderedAt     DateTime?             @db.Timestamptz // when the PM marked it ordered (starts the Ordered TAT)
  orderedById   String?
  pmRemarks     String? // Purchase Manager remark, e.g. why the spare is not available
  // Replacement / Reorder: the earlier unit for this case was defective or not working, so it is ordered again.
  isReplacement          Boolean   @default(false)
  replacementOfId        String? // the request whose unit failed
  replacementReason      String?
  replacementConfirmedById String?
  replacementConfirmedAt DateTime? @db.Timestamptz
  transferredAt DateTime?             @db.Timestamptz // when the last unit was transferred
  slaBreachAt   DateTime?             @db.Timestamptz
  requestedById String?
  reviewedById  String?
  reviewedAt    DateTime?             @db.Timestamptz
  createdAt     DateTime              @default(now()) @db.Timestamptz
  updatedAt     DateTime              @updatedAt @db.Timestamptz

  branch      Branch           @relation(fields: [branchId], references: [id])
  item        Item             @relation(fields: [itemId], references: [id])
  stockUnits  StockUnit[]
  case        Case?            @relation(fields: [caseId], references: [id])
  requestedBy User?            @relation("PRRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?            @relation("PRReviewedBy", fields: [reviewedById], references: [id])
  replacementOf          PurchaseRequest?  @relation("PRReorder", fields: [replacementOfId], references: [id])
  reorders               PurchaseRequest[] @relation("PRReorder")
  replacementConfirmedBy User?             @relation("PRReplacementConfirmedBy", fields: [replacementConfirmedById], references: [id])
  attachments CaseAttachment[]
  isDelete    Int              @default(0) // 0 = active, 1 = soft-deleted

  @@index([branchId, status])
  @@index([itemId])
  @@map("purchase_request")
}

// Planned movement of stock between branches.
model StockTransfer {
  id           String         @id @default(cuid())
  code         String         @unique // "TR-EDP-LAB-2610-001"
  fromBranchId String
  toBranchId   String
  status       TransferStatus @default(PENDING_APPROVAL)
  notes        String?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?      @db.Timestamptz
  dispatchedAt DateTime?      @db.Timestamptz
  receivedAt   DateTime?      @db.Timestamptz
  createdAt    DateTime       @default(now()) @db.Timestamptz
  updatedAt    DateTime       @updatedAt @db.Timestamptz

  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  createdBy  User?               @relation("TransferCreatedBy", fields: [createdById], references: [id])
  approvedBy User?               @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  items      StockTransferItem[]
  isDelete   Int                 @default(0) // 0 = active, 1 = soft-deleted

  @@index([fromBranchId, status])
  @@index([toBranchId, status])
  @@map("stock_transfer")
}

// Line items for a stock transfer.
model StockTransferItem {
  id         String   @id @default(cuid())
  transferId String
  itemId     String
  quantity   Int
  unitCodes  String[]

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  item     Item          @relation(fields: [itemId], references: [id])
  isDelete Int           @default(0) // 0 = active, 1 = soft-deleted

  @@unique([transferId, itemId])
  @@index([transferId])
  @@map("stock_transfer_item")
}

// ─── Direct Sales ─────────────────────────────────────────────────────────────

model DirectSale {
  id            String      @id @default(cuid())
  saleNo        String      @unique // "DS-EDP-2610-001"
  branchId      String
  customerId    String?
  customerName  String
  customerPhone String
  paymentMode   PaymentMode
  totalPaise    Int
  soldById      String
  soldAt        DateTime    @default(now()) @db.Timestamptz
  isActive      Boolean     @default(true)

  branch   Branch           @relation(fields: [branchId], references: [id])
  customer Customer?        @relation(fields: [customerId], references: [id])
  soldBy   User             @relation("DirectSaleSoldBy", fields: [soldById], references: [id])
  items    DirectSaleItem[]
  isDelete Int              @default(0) // 0 = active, 1 = soft-deleted

  @@index([branchId, soldAt])
  @@map("direct_sale")
}

model DirectSaleItem {
  id             String @id @default(cuid())
  saleId         String
  itemId         String
  itemName       String
  quantity       Int
  unitPricePaise Int
  totalPaise     Int

  sale     DirectSale @relation(fields: [saleId], references: [id])
  item     Item       @relation(fields: [itemId], references: [id])
  isDelete Int        @default(0) // 0 = active, 1 = soft-deleted

  @@index([saleId])
  @@map("direct_sale_item")
}

// ─── Buyback ─────────────────────────────────────────────────────────────────

enum BuybackStatus {
  PENDING_ASSESSMENT
  SENT_FOR_REFURBISHMENT
  ADDED_TO_REFURB_STOCK
  SOLD
  SCRAPPED
}

model BuybackRecord {
  id               String        @id @default(cuid())
  branchId         String
  customerId       String?
  customerName     String
  customerPhone    String
  deviceName       String
  brand            String?
  deviceModel      String?
  condition        String // e.g. "WORKING", "PARTIAL", "NOT_WORKING"
  agreedPricePaise Int
  status           BuybackStatus @default(PENDING_ASSESSMENT)
  notes            String?
  recordedById     String
  recordedAt       DateTime      @default(now()) @db.Timestamptz
  isActive         Boolean       @default(true)

  branch     Branch      @relation(fields: [branchId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  recordedBy User        @relation("BuybackRecordedBy", fields: [recordedById], references: [id])
  refurbItem RefurbItem?
  isDelete   Int         @default(0) // 0 = active, 1 = soft-deleted

  @@index([branchId, recordedAt])
  @@map("buyback_record")
}

// ─── Refurbished stock ───────────────────────────────────────────────────────

enum RefurbStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model RefurbItem {
  id                String       @id @default(cuid())
  branchId          String
  buybackId         String?      @unique
  name              String
  brand             String
  specs             String
  grade             String // "A" / "B" / "C"
  costPaise         Int
  sellingPricePaise Int
  warrantyMonths    Int          @default(36)
  serialNo          String?
  status            RefurbStatus @default(AVAILABLE)
  addedAt           DateTime     @default(now()) @db.Timestamptz
  isActive          Boolean      @default(true)

  branch   Branch         @relation(fields: [branchId], references: [id])
  buyback  BuybackRecord? @relation(fields: [buybackId], references: [id])
  isDelete Int            @default(0) // 0 = active, 1 = soft-deleted

  @@index([branchId, status])
  @@map("refurb_item")
}

// ─── Sales Targets ────────────────────────────────────────────────────────────

enum TargetPeriod {
  DAILY
  MONTHLY
  YEARLY
}

model SalesTarget {
  id          String       @id @default(cuid())
  branchId    String
  period      TargetPeriod
  year        Int
  month       Int? // 1–12; null for YEARLY
  day         Int? // 1–31; null for DAILY and MONTHLY
  targetPaise Int
  isActive    Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User?  @relation("SalesTargetCreatedBy", fields: [createdById], references: [id])
  isDelete  Int    @default(0) // 0 = active, 1 = soft-deleted

  @@unique([branchId, period, year, month, day])
  @@index([branchId, period, year])
  @@map("sales_target")
}

// ─── Chip-Level Lab ──────────────────────────────────────────────────────────

// External vendors used for chip-level outsourcing.
model ChipLabVendor {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  remarks     String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  createdBy  User?              @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?              @relation("VendorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  outsources ChipLabOutsource[]
  labCases   Case[]             @relation("CaseLabVendor")
  isDelete   Int                @default(0) // 0 = active, 1 = soft-deleted

  @@index([isActive])
  @@map("chip_lab_vendor")
}

// Tracks one outsourced repair to an external vendor. Append-only: a case that
// is outsourced multiple times gets multiple rows.
model ChipLabOutsource {
  id               String    @id @default(cuid())
  caseId           String
  vendorId         String
  sentAt           DateTime  @db.Timestamptz
  expectedReturnAt DateTime? @db.Timestamptz
  actualReturnAt   DateTime? @db.Timestamptz
  referenceNo      String?
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz

  case      Case          @relation(fields: [caseId], references: [id])
  vendor    ChipLabVendor @relation(fields: [vendorId], references: [id])
  createdBy User?         @relation("OutsourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  isDelete  Int           @default(0) // 0 = active, 1 = soft-deleted

  @@index([caseId])
  @@map("chip_lab_outsource")
}

// Money paid to the outsource vendor for a case. Append-only; the vendor due is
// Σ(CaseItem.vendorCostPaise × quantity) minus the sum of these payments.
model ChipLabVendorPayment {
  id          String   @id @default(cuid())
  caseId      String
  amountPaise Int
  note        String?
  paidAt      DateTime @default(now()) @db.Timestamptz
  paidById    String?

  case     Case  @relation(fields: [caseId], references: [id])
  paidBy   User? @relation("VendorPaymentBy", fields: [paidById], references: [id], onDelete: SetNull)
  isDelete Int   @default(0) // 0 = active, 1 = soft-deleted

  @@index([caseId])
  @@map("chip_lab_vendor_payment")
}

// Master list of quality-check points verified during the lab QC stage.
model QcChecklistItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  createdBy User?            @relation("QcChecklistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?            @relation("QcChecklistUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  responses CaseQcResponse[]
  isDelete  Int              @default(0) // 0 = active, 1 = soft-deleted

  @@index([isActive])
  @@map("qc_checklist_item")
}

// One answer to one checklist point at a QC stage (branch QUALITY_CHECK or
// CHIP_LAB_QUALITY_CHECK). Never updated: re-saving stamps removedAt on the old
// rows and inserts new ones. A QC round counts only when answered after the
// case entered the stage (createdAt >= Case.stageChangedAt).
model CaseQcResponse {
  id              String     @id @default(cuid())
  caseId          String
  checklistItemId String
  stage           CaseStatus
  title           String // checklist wording when answered
  passed          Boolean
  remarks         String?
  answeredById    String?
  createdAt       DateTime   @default(now()) @db.Timestamptz
  removedAt       DateTime?  @db.Timestamptz

  case          Case            @relation(fields: [caseId], references: [id])
  checklistItem QcChecklistItem @relation(fields: [checklistItemId], references: [id])
  answeredBy    User?           @relation("QcResponseAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  isDelete      Int             @default(0) // 0 = active, 1 = soft-deleted

  @@index([caseId, stage, removedAt])
  @@map("case_qc_response")
}

// ─── AI Agents ────────────────────────────────────────────────────────────────

// Append-only log of every Kiran conversation turn.
model AiAgentRun {
  id         String   @id @default(cuid())
  agentName  String // "kiran"
  userId     String
  branchId   String? // null = all-branch scope
  question   String
  answer     String
  tokensUsed Int?
  durationMs Int?
  error      String?
  createdAt  DateTime @default(now()) @db.Timestamptz
  isDelete   Int      @default(0) // 0 = active, 1 = soft-deleted

  @@index([userId, createdAt])
  @@index([agentName, createdAt])
  @@map("ai_agent_run")
}

// ─── Inventory: purchase billing ─────────────────────────────────────────────

enum BillPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// Who we buy stock from. Matched by GSTIN when the bill has one, otherwise by name.
model Supplier {
  id        String   @id @default(cuid())
  name      String
  gstin     String?  @unique
  state     String? // "Kerala, Code : 32"
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  bills    PurchaseBill[]
  isDelete Int            @default(0) // 0 = active, 1 = soft-deleted

  @@index([name])
  @@map("supplier")
}

// A confirmed supplier bill. Saving it adds the lines to branch stock and records
// the payment, all in one transaction. Money is integer paise.
model PurchaseBill {
  id            String            @id @default(cuid())
  code          String            @unique // "PB-EDP-2610-001"
  branchId      String
  supplierId    String
  billNo        String // as printed on the bill
  billNoNorm    String // upper-case letters+digits only, for duplicate checks
  billDate      DateTime          @db.Date
  subtotalPaise Int // Σ taxable amount
  taxPaise      Int // Σ GST
  roundOffPaise Int               @default(0)
  totalPaise    Int
  paidPaise     Int               @default(0)
  paymentStatus BillPaymentStatus @default(UNPAID)
  imageUrl      String?
  imageHash     String? // sha256 of the uploaded bill image
  notes         String?
  createdById   String?
  createdAt     DateTime          @default(now()) @db.Timestamptz
  updatedAt     DateTime          @updatedAt @db.Timestamptz

  branch    Branch                @relation(fields: [branchId], references: [id])
  supplier  Supplier              @relation(fields: [supplierId], references: [id])
  createdBy User?                 @relation("BillCreatedBy", fields: [createdById], references: [id])
  items     PurchaseBillItem[]
  payments  PurchaseBillPayment[]
  isDelete  Int                   @default(0) // 0 = active, 1 = soft-deleted

  @@unique([supplierId, billNoNorm])
  @@index([branchId, billDate])
  @@index([imageHash])
  @@map("purchase_bill")
}

model PurchaseBillItem {
  id             String   @id @default(cuid())
  billId         String
  itemId         String
  description    String // name as printed on the bill
  hsnSac         String?
  quantity       Int
  unitCostPaise  Int // rate per unit, before discount and GST
  discountPaise  Int      @default(0) // line discount, off quantity × unitCost
  gstPercent     Int
  taxablePaise   Int // quantity × unitCost − discount
  taxPaise       Int
  lineTotalPaise Int
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz

  bill       PurchaseBill @relation(fields: [billId], references: [id])
  item       Item         @relation(fields: [itemId], references: [id])
  isDelete   Int          @default(0) // 0 = active, 1 = soft-deleted
  stockUnits StockUnit[]

  @@index([billId])
  @@index([itemId])
  @@map("purchase_bill_item")
}

model PurchaseBillPayment {
  id          String      @id @default(cuid())
  billId      String
  amountPaise Int
  mode        PaymentMode
  referenceNo String?
  note        String?
  paidAt      DateTime    @default(now()) @db.Timestamptz
  createdById String?
  createdAt   DateTime    @default(now()) @db.Timestamptz

  bill      PurchaseBill @relation(fields: [billId], references: [id])
  createdBy User?        @relation("BillPaymentBy", fields: [createdById], references: [id])
  isDelete  Int          @default(0) // 0 = active, 1 = soft-deleted

  @@index([billId])
  @@map("purchase_bill_payment")
}

enum StockUnitStatus {
  AVAILABLE // in stock, can be allocated
  ALLOCATED // allocated to a case at a branch, awaiting the branch's receipt; never allocated again
  RECEIVED // the branch confirmed it received the unit (in branch stock, not yet used)
  CONSUMED // the branch used the unit
  RETURNED // courier / branch damage: back at Head Office, a replacement is bought, this unit is not reused
  AWAITING_VENDOR // defective / not working: with Head Office, waiting for the vendor to replace it (same USID)
}

enum StockUnitAction {
  ALLOCATED
  RECEIVED
  CONSUMED
  RETURNED
  REPLACED // the vendor replaced a defective unit; the same USID is available again
}

// One physical unit of purchased stock, with its own Unique Stock ID. Created when a supplier
// bill is saved (one row per unit). The Purchase Manager allocates a specific USID to a case.
model StockUnit {
  id                String          @id @default(cuid())
  usid              String          @unique // "USID-EDP-2610-00001"
  itemId            String
  billItemId        String? // null = opening / adjusted stock with no supplier bill
  branchId          String // where the unit is held
  status            StockUnitStatus @default(AVAILABLE)
  // Set once, when the unit is allocated.
  allocatedAt       DateTime?       @db.Timestamptz
  allocatedById     String?
  allocatedCaseId   String?
  allocatedBranchId String? // the case's branch
  purchaseRequestId String? // the request this allocation met, if any
  // Set once, when the branch confirms receipt.
  receivedAt        DateTime?       @db.Timestamptz
  receivedById      String?
  // Set once, when the branch uses the unit.
  consumedAt        DateTime?       @db.Timestamptz
  consumedById      String?
  // Set when a branch or the lab returns the unit (courier damage or defective).
  returnType        String? // COURIER_DAMAGE | DEFECTIVE
  returnRemarks     String?
  returnedAt        DateTime?       @db.Timestamptz
  returnedById      String?
  returnReceivedAt  DateTime?       @db.Timestamptz // Head Office confirmed the returned unit has arrived
  returnReceivedById String?
  note              String?
  createdAt         DateTime        @default(now()) @db.Timestamptz

  item             Item              @relation(fields: [itemId], references: [id])
  billItem         PurchaseBillItem? @relation(fields: [billItemId], references: [id])
  branch           Branch            @relation("UnitLocation", fields: [branchId], references: [id])
  allocatedBy      User?             @relation("UnitAllocatedBy", fields: [allocatedById], references: [id])
  receivedBy       User?             @relation("UnitReceivedBy", fields: [receivedById], references: [id])
  consumedBy       User?             @relation("UnitConsumedBy", fields: [consumedById], references: [id])
  events           StockUnitEvent[]
  allocatedCase    Case?             @relation(fields: [allocatedCaseId], references: [id])
  allocatedBranch  Branch?           @relation("UnitAllocatedBranch", fields: [allocatedBranchId], references: [id])
  purchaseRequest  PurchaseRequest?  @relation(fields: [purchaseRequestId], references: [id])
  isDelete         Int               @default(0) // 0 = active, 1 = soft-deleted
  caseItemReturn   CaseItemReturn?   @relation(fields: [caseItemReturnId], references: [id])
  caseItemReturnId String?
  attachments      CaseAttachment[]
  usages           CaseItemUsage[]
  vendorReplacements VendorReplacement[]

  @@index([status, itemId])
  @@index([branchId, status])
  @@index([allocatedCaseId])
  @@index([billItemId])
  @@index([purchaseRequestId])
  @@map("stock_unit")
}

// Append-only history of a stock unit: each allocation and each receipt, with who/when/where.
model StockUnitEvent {
  id       String          @id @default(cuid())
  unitId   String
  action   StockUnitAction
  userId   String?
  caseId   String?
  branchId String? // the branch it was allocated to / received at
  note     String?
  at       DateTime        @default(now()) @db.Timestamptz

  unit     StockUnit @relation(fields: [unitId], references: [id])
  user     User?     @relation("UnitEventBy", fields: [userId], references: [id])
  case     Case?     @relation(fields: [caseId], references: [id])
  branch   Branch?   @relation("UnitEventBranch", fields: [branchId], references: [id])
  isDelete Int       @default(0) // 0 = active, 1 = soft-deleted

  @@index([unitId, at])
  @@index([caseId])
  @@map("stock_unit_event")
}

// Inventory configuration: a single row (id "default").
// USID numbering: <prefix><number padded to width>, e.g. HG0001. Changing it only affects USIDs issued from then
// on; existing USIDs never change. GST rates: the percentages offered on purchase bill lines.
model InventoryConfig {
  id          String   @id @default("default")
  prefix      String // "HG"
  width       Int // digits, leading zeros kept: 4 → 0001
  nextNumber  Int // the number the next unit gets
  gstRates    Int[] @default([0, 5, 12, 18, 28]) // GST % choices on billing items
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  updatedBy User? @relation("InventoryConfigUpdatedBy", fields: [updatedById], references: [id])
  isDelete  Int   @default(0) // 0 = active, 1 = soft-deleted

  @@map("inventory_config")
}

enum CaseItemUsageKind {
  CONSUMED // the part was used on the case
  RETURNED_UNUSED // received but not needed: back to Head Office stock
  RETURNED_DEFECTIVE // received but defective / not working / wrong: sent back to Head Office, not reusable
}

// What happened to each part received for a case: used, or returned before the case closed. A case may move to Quality
// check only when every part on it is CONSUMED or RETURNED_UNUSED. Survives edits of the case items (which re-insert lines).
model CaseItemUsage {
  id          String            @id @default(cuid())
  caseId      String
  itemId      String
  kind        CaseItemUsageKind
  stockUnitId String? // the USID, when the part came from a transferred unit
  reason      String? // return reason
  remarks     String?
  userId      String?
  at          DateTime          @default(now()) @db.Timestamptz

  case      Case       @relation(fields: [caseId], references: [id])
  stockUnit StockUnit? @relation(fields: [stockUnitId], references: [id])
  user      User?      @relation("CaseItemUsageBy", fields: [userId], references: [id])
  isDelete  Int        @default(0) // 0 = active, 1 = soft-deleted

  @@index([caseId, itemId])
  @@map("case_item_usage")
}

enum VendorReplacementStatus {
  REQUESTED // defective unit returned; replacement asked from the vendor
  READY // the vendor has the replacement ready (same USID)
  TRANSFERRED // sent to the branch for the case, awaiting its receipt
  RECEIVED // the branch received it
}

// A defective / not-working unit sent back for a vendor replacement. The replacement reuses the same USID: no new purchase
// and no new stock entry. It can be requested, readied and transferred to the branch before the defective unit reaches Head
// Office; the defective unit's own return (returnReceivedAt) is tracked separately here.
model VendorReplacement {
  id                 String                  @id @default(cuid())
  code               String                  @unique // "VR-KZKD-2610-001"
  unitId             String // the original USID, reused for the replacement
  caseId             String?
  branchId           String // the case's branch: where the replacement goes
  itemId             String
  vendorName         String?
  remarks            String? // why it was returned
  vendorRemarks      String?
  status             VendorReplacementStatus @default(REQUESTED)
  requestedById      String?
  requestedAt        DateTime                @default(now()) @db.Timestamptz
  vendorReadyAt      DateTime?               @db.Timestamptz
  vendorReadyById    String?
  transferredAt      DateTime?               @db.Timestamptz
  transferredById    String?
  receivedAt         DateTime?               @db.Timestamptz // the branch received the replacement
  receivedById       String?
  returnReceivedAt   DateTime?               @db.Timestamptz // Head Office received the defective unit
  returnReceivedById String?
  createdAt          DateTime                @default(now()) @db.Timestamptz
  updatedAt          DateTime                @updatedAt @db.Timestamptz

  unit     StockUnit @relation(fields: [unitId], references: [id])
  case     Case?     @relation(fields: [caseId], references: [id])
  branch   Branch    @relation(fields: [branchId], references: [id])
  item     Item      @relation(fields: [itemId], references: [id])
  isDelete Int       @default(0) // 0 = active, 1 = soft-deleted

  @@index([status])
  @@index([unitId])
  @@index([caseId])
  @@map("vendor_replacement")
}

// ─── Case billing ────────────────────────────────────────────────────────────

// The final bill of a case, generated when it is closed. One per case (the unique caseId makes a second close impossible).
// Prices follow the GST rule at the time (inclusive or exclusive); taxable + tax = total.
model CaseInvoice {
  id            String            @id @default(cuid())
  invoiceNo     String            @unique // "INV-KZKD-2610-0001"
  caseId        String            @unique
  branchId      String
  customerId    String
  gstInclusive  Boolean           @default(true)
  subtotalPaise Int // taxable amount
  taxPaise      Int
  totalPaise    Int
  paidPaise     Int               @default(0) // advance applied + everything collected since
  creditedPaise Int               @default(0) // reduced by credit notes (due = total − credited − paid)
  paymentStatus BillPaymentStatus @default(UNPAID)
  notes         String?
  issuedById    String?
  issuedAt      DateTime          @default(now()) @db.Timestamptz
  createdAt     DateTime          @default(now()) @db.Timestamptz
  updatedAt     DateTime          @updatedAt @db.Timestamptz

  case        Case              @relation(fields: [caseId], references: [id])
  branch      Branch            @relation(fields: [branchId], references: [id])
  customer    Customer          @relation(fields: [customerId], references: [id])
  lines       CaseInvoiceLine[]
  payments    Payment[]
  creditNotes CreditNote[]
  isDelete    Int               @default(0) // 0 = active, 1 = soft-deleted

  @@index([branchId, issuedAt])
  @@index([customerId])
  @@map("case_invoice")
}

model CaseInvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  itemId         String?
  code           String
  name           String
  type           String // SERVICE | PART | ACCESSORY
  hsnSac         String?
  quantity       Int
  unitPricePaise Int
  gstPercent     Int
  taxablePaise   Int
  taxPaise       Int
  lineTotalPaise Int
  addedAtBilling Boolean @default(false) // an accessory / product added in the closing bill, not a case item
  sortOrder      Int     @default(0)

  invoice  CaseInvoice @relation(fields: [invoiceId], references: [id])
  isDelete Int         @default(0) // 0 = active, 1 = soft-deleted

  @@index([invoiceId])
  @@map("case_invoice_line")
}

// A credit note reduces an invoice (return, price correction): the amount is GST-inclusive.
model CreditNote {
  id          String   @id @default(cuid())
  noteNo      String   @unique // "CN-KZKD-2610-001"
  invoiceId   String
  amountPaise Int
  taxPaise    Int
  reason      String
  refundMode  PaymentMode? // set when the amount is refunded in cash / bank instead of reducing the customer's due
  refundPaise Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  invoice  CaseInvoice @relation(fields: [invoiceId], references: [id])
  isDelete Int         @default(0) // 0 = active, 1 = soft-deleted

  @@index([invoiceId])
  @@map("credit_note")
}

// ─── Accounting (double entry) ───────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// The chart of accounts. Branch-wise books use the branch on each journal line, not separate accounts.
model Account {
  id        String      @id @default(cuid())
  code      String      @unique // "1000"
  name      String
  type      AccountType
  subType   String? // CASH | BANK | RECEIVABLE | PAYABLE | INVENTORY | GST_INPUT | GST_OUTPUT | ADVANCE | INTERBRANCH …
  isSystem  Boolean     @default(false) // posted to automatically; cannot be removed
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz

  lines    JournalLine[]
  isDelete Int           @default(0) // 0 = active, 1 = soft-deleted

  @@map("account")
}

// One balanced posting. Entries are never edited or deleted: a mistake is corrected by a reversal entry.
// (sourceType, sourceId) is unique, so the same event can never be posted twice.
model JournalEntry {
  id          String   @id @default(cuid())
  entryNo     String   @unique // "JV-2610-000123"
  entryDate   DateTime @default(now()) @db.Timestamptz
  branchId    String? // where it happened (null = Head Office level)
  narration   String
  sourceType  String // CASE_INVOICE | CASE_PAYMENT | PURCHASE_BILL | PURCHASE_PAYMENT | DIRECT_SALE | EXPENSE | TRANSFER | CREDIT_NOTE | COGS | MANUAL | REVERSAL
  sourceId    String?
  reversalOfId String?
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  lines    JournalLine[]
  isDelete Int           @default(0) // 0 = active, 1 = soft-deleted

  @@unique([sourceType, sourceId])
  @@index([entryDate])
  @@index([branchId, entryDate])
  @@map("journal_entry")
}

model JournalLine {
  id          String  @id @default(cuid())
  entryId     String
  accountId   String
  branchId    String
  debitPaise  Int     @default(0)
  creditPaise Int     @default(0)
  partyType   String? // CUSTOMER | SUPPLIER
  partyId     String?
  memo        String?

  entry    JournalEntry @relation(fields: [entryId], references: [id])
  account  Account      @relation(fields: [accountId], references: [id])
  branch   Branch       @relation(fields: [branchId], references: [id])
  isDelete Int          @default(0) // 0 = active, 1 = soft-deleted

  @@index([accountId, branchId])
  @@index([entryId])
  @@index([partyType, partyId])
  @@map("journal_line")
}
