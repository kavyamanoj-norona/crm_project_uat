// Laptop Clinic CRM — Prisma schema
// One schema, grouped by module (see blueprint §11). No hard deletes:
// records are switched off with `isActive` instead.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Organisation: company → branch, domain → department ─────────────────────

model Company {
  id        String   @id @default(cuid())
  code      String   @unique // "NTL"
  name      String
  gstin     String?
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  branches Branch[]
  users    User[]

  @@map("company")
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  code      String   @unique // "EDP" — used in jobsheet numbers
  name      String // "Edappally"
  phone     String?
  address   String?
  // Virtual branches (e.g. the chip-level lab) hold stock/jobs but no counter.
  isVirtual Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  company  Company   @relation(fields: [companyId], references: [id])
  users     User[]
  cases     Case[]
  payments  Payment[]
  customers Customer[]

  stockItems       StockItem[]
  purchaseRequests PurchaseRequest[]
  transfersOut     StockTransfer[]   @relation("TransferFrom")
  transfersIn      StockTransfer[]   @relation("TransferTo")

  directSales    DirectSale[]
  buybackRecords BuybackRecord[]
  refurbItems    RefurbItem[]
  salesTargets   SalesTarget[]

  @@index([companyId])
  @@map("branch")
}

model Domain {
  id        String   @id @default(cuid())
  code      String   @unique // "SALES"
  name      String // "Sales"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  departments Department[]
  users       User[]

  @@map("domain")
}

model Department {
  id        String   @id @default(cuid())
  domainId  String
  name      String // "Sales Team"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  domain Domain @relation(fields: [domainId], references: [id])
  users  User[]

  @@unique([domainId, name])
  @@map("department")
}

// ─── Access: privilege (role) → permissions on menu items ────────────────────

model Privilege {
  id            String   @id @default(cuid())
  code          String   @unique // ADMIN, BRANCH_MANAGER, SALES …
  name          String
  description   String?
  // Super-admin privileges see every active module and menu without permission rows.
  isSuperAdmin  Boolean  @default(false)
  // Branch-bound privileges only ever see their own branch's data.
  isBranchBound Boolean  @default(true)
  // Landing page after login when the user has no default module.
  homePath      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  users       User[]
  permissions PrivilegePermission[]

  @@map("privilege")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentStatus {
  WORKING
  ON_LEAVE
  RESIGNED
  TERMINATED
}

model User {
  id               String           @id @default(cuid())
  userCode         String           @unique // "LC00001"
  firstName        String
  lastName         String?
  mobile           String           @unique
  email            String           @unique
  username         String           @unique
  passwordHash     String
  dob              DateTime?        @db.Date
  gender           Gender?
  maritalStatus    MaritalStatus?
  state            String?
  district         String?
  address          String?
  imageUrl         String?
  joiningDate      DateTime?        @db.Date
  status           EmploymentStatus @default(WORKING)
  twoFactorEnabled Boolean          @default(false)
  // Locked by an administrator (unlock from the Users screen).
  isLocked         Boolean          @default(false)
  // Automatic lockout after too many failed sign-ins (limits come from Rules).
  failedLoginCount Int              @default(0)
  lockedUntil      DateTime?        @db.Timestamptz
  lastLoginAt      DateTime?        @db.Timestamptz
  isActive         Boolean          @default(true)

  companyId       String
  branchId        String?
  domainId        String
  departmentId    String
  privilegeId     String
  defaultModuleId String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  company       Company           @relation(fields: [companyId], references: [id])
  branch        Branch?           @relation(fields: [branchId], references: [id])
  domain        Domain            @relation(fields: [domainId], references: [id])
  department    Department        @relation(fields: [departmentId], references: [id])
  privilege     Privilege         @relation(fields: [privilegeId], references: [id])
  defaultModule Module?           @relation(fields: [defaultModuleId], references: [id])
  createdBy     User?             @relation("UserCreatedBy", fields: [createdById], references: [id])
  created       User[]            @relation("UserCreatedBy")
  activity      UserActivityLog[]
  blockedIps    BlockedIp[]
  rulesUpdated  Rule[]

  customersCreated Customer[]          @relation("CustomerCreatedBy")
  customersUpdated Customer[]          @relation("CustomerUpdatedBy")
  casesCreated     Case[]              @relation("CaseCreatedBy")
  casesUpdated     Case[]              @relation("CaseUpdatedBy")
  casesAssigned    Case[]              @relation("CaseEngineer")
  caseStatusMoves  CaseStatusHistory[]
  caseAttachments  CaseAttachment[]
  paymentsReceived Payment[]
  itemsCreated     Item[]              @relation("ItemCreatedBy")
  itemsUpdated     Item[]              @relation("ItemUpdatedBy")
  caseItemsAdded   CaseItem[]          @relation("CaseItemAddedBy")
  caseItemsRemoved CaseItem[]          @relation("CaseItemRemovedBy")
  whatsappMessages WhatsAppMessage[]

  caseFeedbacks            CaseFeedback[]
  tatConfigsCreated        TatConfig[]    @relation("TatConfigCreatedBy")
  tatConfigsUpdated        TatConfig[]    @relation("TatConfigUpdatedBy")

  stockItemsUpdated        StockItem[]        @relation("StockItemUpdatedBy")
  purchaseRequestsRaised   PurchaseRequest[]  @relation("PRRequestedBy")
  purchaseRequestsReviewed PurchaseRequest[]  @relation("PRReviewedBy")
  transfersCreated         StockTransfer[]    @relation("TransferCreatedBy")
  transfersApproved        StockTransfer[]    @relation("TransferApprovedBy")

  directSalesSold     DirectSale[]    @relation("DirectSaleSoldBy")
  buybacksRecorded    BuybackRecord[] @relation("BuybackRecordedBy")
  salesTargetsCreated SalesTarget[]   @relation("SalesTargetCreatedBy")

  labVendorsCreated    ChipLabVendor[]    @relation("VendorCreatedBy")
  labVendorsUpdated    ChipLabVendor[]    @relation("VendorUpdatedBy")
  labOutsourcesCreated ChipLabOutsource[] @relation("OutsourceCreatedBy")
  labCases             Case[]             @relation("CaseLabEngineer")
  qcChecklistCreated   QcChecklistItem[]  @relation("QcChecklistCreatedBy")
  qcChecklistUpdated   QcChecklistItem[]  @relation("QcChecklistUpdatedBy")
  qcResponsesAnswered  CaseQcResponse[]   @relation("QcResponseAnsweredBy")
  labTransfersCompleted Case[]            @relation("CaseLabTransferBy")

  @@index([companyId])
  @@index([branchId])
  @@index([privilegeId])
  @@map("user")
}

// ─── Navigation: modules → groups → items ────────────────────────────────────
//
// Module  = one icon on the rail / one tile in the app switcher.
// Menu    = entries of the module sidebar. A GROUP is a collapsible heading,
//           an ITEM is a link. Items may sit directly under a module
//           (parentId = null) or inside a group.
//
// Visibility: an ITEM shows when the user's privilege has canView;
// a GROUP shows when at least one child item shows; a MODULE shows when at
// least one of its items shows. Add rows here and the UI picks them up.

enum MenuType {
  GROUP
  ITEM
}

model Module {
  id        String   @id @default(cuid())
  code      String   @unique // "service"
  title     String // "Service"
  icon      String // lucide icon name in kebab-case, e.g. "wrench"
  path      String   @unique // route prefix, e.g. "/service"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  menus        Menu[]
  defaultUsers User[]

  @@map("module")
}

model Menu {
  id        String   @id @default(cuid())
  moduleId  String
  parentId  String?
  type      MenuType @default(ITEM)
  code      String   @unique // "service.cases.all-cases"
  title     String
  icon      String? // lucide icon name, optional
  path      String?  @unique // required for ITEM, null for GROUP
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  module      Module                @relation(fields: [moduleId], references: [id])
  parent      Menu?                 @relation("MenuTree", fields: [parentId], references: [id])
  children    Menu[]                @relation("MenuTree")
  permissions PrivilegePermission[]

  @@index([moduleId])
  @@index([parentId])
  @@map("menu")
}

model PrivilegePermission {
  id          String   @id @default(cuid())
  privilegeId String
  menuId      String
  canView     Boolean  @default(true)
  canCreate   Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  canApprove  Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  privilege Privilege @relation(fields: [privilegeId], references: [id])
  menu      Menu      @relation(fields: [menuId], references: [id])

  @@unique([privilegeId, menuId])
  @@index([menuId])
  @@map("privilege_permission")
}

// ─── Rules: business settings editable in Master Settings → Rules ───────────

enum RuleValueType {
  NUMBER
  PERCENT
  HOURS
  MINUTES
  BOOLEAN
  TEXT
}

model Rule {
  id          String        @id @default(cuid())
  code        String        @unique // "DISCOUNT_CAP_PERCENT" — read by code via getRule()
  name        String
  category    String // "Pricing", "Service TAT", "Security" …
  valueType   RuleValueType
  value       String // stored as text, parsed by valueType
  description String?
  isActive    Boolean       @default(true)
  updatedById String?
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@index([category])
  @@map("rule")
}

// ─── Item catalog (Master Settings → Manage → Items) ─────────────────────────

enum ItemType {
  SERVICE // labour / service charge
  PART // spare part fitted in the device
  ACCESSORY // sold alongside (bag, mouse …)
}

// What a case can be billed for. Price is the list price; the lowest price
// staff may bill is price × (100 − maxDiscountPercent) / 100 (minimum selling price).
model Item {
  id                 String   @id @default(cuid())
  code               String   @unique // "SV-CLN", "KB-DELL-5518"
  name               String
  type               ItemType @default(SERVICE)
  category           String? // "Keyboard", "Display", "Cleaning" …
  brand              String?
  unit               String   @default("Nos")
  hsnSac             String? // HSN (goods) / SAC (services) code for GST invoices
  gstPercent         Int      @default(18)
  pricePaise         Int
  maxDiscountPercent Int      @default(0)
  warrantyDays       Int?
  description        String?
  isActive           Boolean  @default(true)
  createdById        String?
  updatedById        String?
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz

  createdBy User?      @relation("ItemCreatedBy", fields: [createdById], references: [id])
  updatedBy User?      @relation("ItemUpdatedBy", fields: [updatedById], references: [id])
  caseItems CaseItem[]

  stockItems        StockItem[]
  purchaseRequests  PurchaseRequest[]
  transferItems     StockTransferItem[]

  directSaleItems DirectSaleItem[]

  @@index([name])
  @@index([type, isActive])
  @@map("item")
}

// ─── Numbering ───────────────────────────────────────────────────────────────

// Counters behind human codes (blueprint §11). One row per key, e.g.
// "JOBSHEET:EDP:2609" or "CUSTOMER". Incremented atomically by nextSequence()
// inside the transaction that uses the number, so a rolled-back save leaves no gap.
model NumberSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("number_sequence")
}

// ─── Customers ───────────────────────────────────────────────────────────────

enum CustomerType {
  INDIVIDUAL
  BUSINESS // B2B account, e.g. a hotel; can be billed for other people's cases
}

// "How did you hear about us?"
enum LeadSource {
  REPEAT_CUSTOMER
  WALK_IN
  REFERRAL
  ADVERTISEMENT
  SOCIAL_MEDIA
  GOOGLE_SEARCH
  OTHER
}

// Shared by every branch; the phone number is the dedupe key.
model Customer {
  id          String       @id @default(cuid())
  code        String       @unique // "CU000001"
  type        CustomerType @default(INDIVIDUAL)
  name        String
  phone       String       @unique // digits only: 9847012345 or 04842401234
  altPhone    String?
  email       String?
  gstin       String?
  address     String?
  state       String?
  district    String?
  pincode     String?
  // How they first found us; each case keeps its own source too.
  source      LeadSource?
  notes       String?
  // Kept in step by case intake so lists sort without aggregating 100k rows.
  visitCount  Int          @default(0)
  lastVisitAt DateTime?    @db.Timestamptz
  isActive    Boolean      @default(true)
  // The branch that registered the customer; branch users see their own (and customers they've serviced).
  branchId    String?
  createdById String?
  updatedById String?
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  branch           Branch?           @relation(fields: [branchId], references: [id])
  createdBy        User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  cases            Case[]            @relation("CaseCustomer")
  accountCases     Case[]            @relation("CaseAccount")
  payments         Payment[]
  whatsappMessages WhatsAppMessage[]

  directSales    DirectSale[]
  buybackRecords BuybackRecord[]

  @@index([name])
  @@index([createdAt])
  @@index([lastVisitAt])
  @@index([branchId])
  @@map("customer")
}

// ─── Service: cases ──────────────────────────────────────────────────────────

enum IntakeType {
  WALK_IN
  PICKUP
  ON_SITE
}

enum ProductType {
  LAPTOP
  PRINTER
  DESKTOP
  OTHER
}

enum WarrantyStatus {
  NON_WARRANTY
  WARRANTY
  RETURN
}

enum CaseStatus {
  INTAKE
  DIAGNOSIS
  PENDING_APPROVAL
  AWAITING_STOCK
  QUALITY_CHECK
  READY_FOR_DELIVERY
  CLOSED
  CANCELLED
  // Chip-Level Lab track (case keeps the same ID throughout)
  CHIP_TRANSFER             // Branch sent to lab | Lab sees as "Incoming"
  CHIP_LAB_RECEIVED         // Lab physically received the device
  CHIP_LAB_DIAGNOSIS        // Lab running diagnosis
  CHIP_LAB_PENDING_APPROVAL // Pending customer approval on lab estimate
  CHIP_LAB_SERVICING        // Device in active repair at lab
  CHIP_LAB_READY_DISPATCH   // Lab repair done, ready for quality check
  CHIP_LAB_QUALITY_CHECK    // Lab QC before handing back to branch
  CHIP_BRANCH_RECEIVED      // Branch received device back from lab
  NON_REPAIRABLE            // Cannot be repaired (reason stored in CaseStatusHistory.note)
}

enum ItemCondition {
  GOOD
  FAIR
  WORN
  DAMAGED
}

enum PaymentMode {
  UPI
  CASH
  CARD
  OTHER
}

model Case {
  id                   String         @id @default(cuid())
  jobsheetNo           String         @unique // LC-EDP-2609-0001, see modules/service/jobsheet.ts
  branchId             String
  customerId           String
  // B2B account billed for this case (a BUSINESS customer), if any.
  accountId            String?
  intakeType           IntakeType     @default(WALK_IN)
  source               LeadSource
  status               CaseStatus     @default(INTAKE)
  // When the current stage began — drives the "Age" column and TAT alerts.
  stageChangedAt       DateTime       @default(now()) @db.Timestamptz
  // Pickup / on-site visits
  siteAddress          String?
  siteLatitude         Float?
  siteLongitude        Float?
  // Device
  productType          ProductType
  brand                String
  model                String?
  serialNo             String?
  warrantyStatus       WarrantyStatus
  // AES-256-GCM (server/crypto.ts); every reveal is written to the activity log.
  devicePasswordEnc    String?
  problemReported      String
  // Money
  estimatedCostPaise   Int?
  gstInvoiceRequired   Boolean        @default(false)
  expectedDeliveryDate DateTime?      @db.Date
  engineerId           String?
  labWorkType          String?
  labEngineerId        String?
  labVendorId          String?
  // Lab confirms the device was handed over to the branch (set after Transfer to Branch).
  labTransferCompletedAt   DateTime? @db.Timestamptz
  labTransferCompletedById String?
  createdById          String?
  updatedById          String?
  createdAt            DateTime       @default(now()) @db.Timestamptz
  updatedAt            DateTime       @updatedAt @db.Timestamptz

  branch        Branch              @relation(fields: [branchId], references: [id])
  customer      Customer            @relation("CaseCustomer", fields: [customerId], references: [id])
  account       Customer?           @relation("CaseAccount", fields: [accountId], references: [id])
  engineer      User?               @relation("CaseEngineer", fields: [engineerId], references: [id])
  createdBy     User?               @relation("CaseCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?               @relation("CaseUpdatedBy", fields: [updatedById], references: [id])
  items            CaseItem[]
  receivedItems    CaseReceivedItem[]
  attachments      CaseAttachment[]
  statusHistory    CaseStatusHistory[]
  payments         Payment[]
  whatsappMessages WhatsAppMessage[]
  purchaseRequests PurchaseRequest[]
  feedback         CaseFeedback?
  labOutsources    ChipLabOutsource[]
  labEngineer      User?               @relation("CaseLabEngineer", fields: [labEngineerId], references: [id])
  labVendor        ChipLabVendor?      @relation("CaseLabVendor", fields: [labVendorId], references: [id])
  qcResponses      CaseQcResponse[]
  labTransferBy    User?               @relation("CaseLabTransferBy", fields: [labTransferCompletedById], references: [id], onDelete: SetNull)

  @@index([branchId, status, createdAt])
  @@index([branchId, stageChangedAt])
  @@index([customerId])
  @@index([accountId])
  @@index([engineerId])
  @@index([labEngineerId])
  @@index([labVendorId])
  @@map("service_case") // "case" is an SQL keyword
}

// Billable lines of a case, picked from the item catalog at diagnosis. Code,
// name and prices are copied from the item so later catalog edits don't
// rewrite the estimate. Rows are never updated or deleted: editing the
// estimate stamps removedAt on the old lines and inserts new ones.
model CaseItem {
  id             String    @id @default(cuid())
  caseId         String
  itemId         String
  code           String
  name           String
  type           ItemType
  quantity       Int       @default(1)
  listPricePaise Int // catalog price per unit when added
  minPricePaise  Int // lowest allowed per unit when added
  unitPricePaise Int // billed per unit
  gstPercent     Int
  lineTotalPaise Int // unitPrice × quantity
  sortOrder      Int       @default(0)
  addedById      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz
  removedAt      DateTime? @db.Timestamptz
  removedById    String?

  case      Case  @relation(fields: [caseId], references: [id])
  item      Item  @relation(fields: [itemId], references: [id])
  addedBy   User? @relation("CaseItemAddedBy", fields: [addedById], references: [id])
  removedBy User? @relation("CaseItemRemovedBy", fields: [removedById], references: [id])

  @@index([caseId, removedAt])
  @@index([itemId])
  @@map("case_item")
}

// Accessories handed over with the device (charger, bag …).
model CaseReceivedItem {
  id          String        @id @default(cuid())
  caseId      String
  name        String
  referenceNo String?
  condition   ItemCondition @default(GOOD)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz

  case Case @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@map("case_received_item")
}

model CaseAttachment {
  id          String   @id @default(cuid())
  caseId      String
  kind        String   @default("INTAKE_PHOTO")
  url         String
  fileName    String
  sizeBytes   Int
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  case      Case  @relation(fields: [caseId], references: [id])
  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([caseId])
  @@map("case_attachment")
}

// Append-only stage history; the case timeline reads from here.
model CaseStatusHistory {
  id          String      @id @default(cuid())
  caseId      String
  fromStatus  CaseStatus?
  toStatus    CaseStatus
  note        String?
  changedById String?
  at          DateTime    @default(now()) @db.Timestamptz

  case      Case  @relation(fields: [caseId], references: [id])
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([caseId, at])
  @@map("case_status_history")
}

// ─── Service: feedback ───────────────────────────────────────────────────────

enum CustomerBehaviour {
  COOPERATIVE   // polite and easy to work with
  NORMAL        // no notable interaction
  DIFFICULT     // raised concerns / hard to please
  RUDE          // abusive or disrespectful
  EXCELLENT     // went out of their way to appreciate the team
}

// One-per-case feedback record, written when a case is closed.
model CaseFeedback {
  id                String            @id @default(cuid())
  caseId            String            @unique
  rating            Int               // 1–5 stars
  comment           String?
  customerBehaviour CustomerBehaviour @default(NORMAL)
  createdById       String?
  createdAt         DateTime          @default(now()) @db.Timestamptz
  updatedAt         DateTime          @updatedAt @db.Timestamptz

  case      Case  @relation(fields: [caseId], references: [id])
  createdBy User? @relation(fields: [createdById], references: [id])

  @@map("case_feedback")
}

// ─── Finance ─────────────────────────────────────────────────────────────────

enum PaymentKind {
  ADVANCE
  FINAL
  OTHER
}

enum TatUnit {
  MINUTES
  HOURS
  DAYS
}

// Money received. Immutable: corrections go through refunds / adjustments.
model Payment {
  id           String      @id @default(cuid())
  branchId     String
  caseId       String?
  customerId   String
  kind         PaymentKind
  mode         PaymentMode
  amountPaise  Int
  reference    String? // UPI / card reference
  receivedById String?
  createdAt    DateTime    @default(now()) @db.Timestamptz

  branch     Branch   @relation(fields: [branchId], references: [id])
  case       Case?    @relation(fields: [caseId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  receivedBy User?    @relation(fields: [receivedById], references: [id])

  @@index([branchId, createdAt])
  @@index([caseId])
  @@index([customerId])
  @@map("payment")
}

// TAT (Turnaround Time) targets per workflow stage. Global config — no branchId.
model TatConfig {
  id                  String     @id @default(cuid())
  status              CaseStatus @unique
  targetValue         Int        // the numeric TAT (e.g. 4 for 4 hours)
  targetUnit          TatUnit    @default(HOURS)
  warningThreshold    Int        @default(80)  // % of TAT elapsed at which to show warning
  escalationThreshold Int        @default(100) // % of TAT at which it becomes overdue
  isActive            Boolean    @default(true)
  remarks             String?
  createdById         String?
  updatedById         String?
  createdAt           DateTime   @default(now()) @db.Timestamptz
  updatedAt           DateTime   @updatedAt @db.Timestamptz

  createdBy User? @relation("TatConfigCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("TatConfigUpdatedBy", fields: [updatedById], references: [id])

  @@map("tat_config")
}

// ─── Security ────────────────────────────────────────────────────────────────

model BlockedIp {
  id          String   @id @default(cuid())
  ip          String   @unique
  reason      String?
  isActive    Boolean  @default(true)
  blockedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  blockedBy User? @relation(fields: [blockedById], references: [id])

  @@map("blocked_ip")
}

// Append-only: rows are inserted, never updated or deleted.
model UserActivityLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now()) @db.Timestamptz
  userId    String? // null when the username didn't match anyone
  username  String? // what was typed, for failed logins
  action    String // "login.success", "login.failed", "logout", "user.create" …
  entity    String?
  entityId  String?
  detail    String?
  ip        String?
  userAgent String?

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, at])
  @@index([at])
  @@map("user_activity_log")
}

// ─── WhatsApp messaging ───────────────────────────────────────────────────────

enum WaMessageStatus {
  QUEUED
  SENT
  FAILED
}

// Append-only log of every WhatsApp template message sent from a service case.
model WhatsAppMessage {
  id            String          @id @default(cuid())
  caseId        String
  customerId    String
  templateName  String
  phone         String          // E.164 recipient (e.g. +919847012345)
  payload       Json            // Full request body sent to Meta
  status        WaMessageStatus @default(QUEUED)
  metaMessageId String?         // wamid returned by Meta on success
  error         String?
  sentAt        DateTime?       @db.Timestamptz
  createdById   String?
  createdAt     DateTime        @default(now()) @db.Timestamptz

  case      Case     @relation(fields: [caseId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([caseId, createdAt])
  @@map("whatsapp_message")
}

// ─── Inventory: stock, purchasing, transfers ──────────────────────────────────

enum PurchaseRequestStatus {
  PENDING    // raised, awaiting PM review
  WITH_PM    // with purchase manager
  APPROVED   // PM approved; awaiting arrival
  REJECTED   // PM rejected
  FULFILLED  // stock received at branch
}

enum TransferStatus {
  PENDING_APPROVAL // awaiting PM approval
  APPROVED         // approved; ready to dispatch
  DISPATCHED       // sent from source branch
  RECEIVED         // received at destination
  CANCELLED        // cancelled before dispatch
}

// Physical units of an item at a branch. One row per (branch, item) pair.
model StockItem {
  id          String   @id @default(cuid())
  branchId    String
  itemId      String
  quantity    Int      @default(0)
  unitCodes   String[] // individual sticker codes, e.g. ["KB123","KB124"]
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  branch    Branch @relation(fields: [branchId], references: [id])
  item      Item   @relation(fields: [itemId], references: [id])
  updatedBy User?  @relation("StockItemUpdatedBy", fields: [updatedById], references: [id])

  @@unique([branchId, itemId])
  @@index([branchId])
  @@map("stock_item")
}

// A branch requests an item from the purchase manager.
model PurchaseRequest {
  id            String                @id @default(cuid())
  code          String                @unique // "PR-EDP-2610-001"
  branchId      String
  itemId        String
  caseId        String?               // case that triggered the request
  quantity      Int                   @default(1)
  notes         String?
  status        PurchaseRequestStatus @default(PENDING)
  slaBreachAt   DateTime?             @db.Timestamptz
  requestedById String?
  reviewedById  String?
  reviewedAt    DateTime?             @db.Timestamptz
  createdAt     DateTime              @default(now()) @db.Timestamptz
  updatedAt     DateTime              @updatedAt @db.Timestamptz

  branch      Branch @relation(fields: [branchId], references: [id])
  item        Item   @relation(fields: [itemId], references: [id])
  case        Case?  @relation(fields: [caseId], references: [id])
  requestedBy User?  @relation("PRRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?  @relation("PRReviewedBy", fields: [reviewedById], references: [id])

  @@index([branchId, status])
  @@index([itemId])
  @@map("purchase_request")
}

// Planned movement of stock between branches.
model StockTransfer {
  id           String         @id @default(cuid())
  code         String         @unique // "TR-EDP-LAB-2610-001"
  fromBranchId String
  toBranchId   String
  status       TransferStatus @default(PENDING_APPROVAL)
  notes        String?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?      @db.Timestamptz
  dispatchedAt DateTime?      @db.Timestamptz
  receivedAt   DateTime?      @db.Timestamptz
  createdAt    DateTime       @default(now()) @db.Timestamptz
  updatedAt    DateTime       @updatedAt @db.Timestamptz

  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  createdBy  User?               @relation("TransferCreatedBy", fields: [createdById], references: [id])
  approvedBy User?               @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  items      StockTransferItem[]

  @@index([fromBranchId, status])
  @@index([toBranchId, status])
  @@map("stock_transfer")
}

// Line items for a stock transfer.
model StockTransferItem {
  id         String   @id @default(cuid())
  transferId String
  itemId     String
  quantity   Int
  unitCodes  String[]

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  item     Item          @relation(fields: [itemId], references: [id])

  @@unique([transferId, itemId])
  @@index([transferId])
  @@map("stock_transfer_item")
}

// ─── Direct Sales ─────────────────────────────────────────────────────────────

model DirectSale {
  id            String      @id @default(cuid())
  saleNo        String      @unique // "DS-EDP-2610-001"
  branchId      String
  customerId    String?
  customerName  String
  customerPhone String
  paymentMode   PaymentMode
  totalPaise    Int
  soldById      String
  soldAt        DateTime    @default(now()) @db.Timestamptz
  isActive      Boolean     @default(true)

  branch   Branch           @relation(fields: [branchId], references: [id])
  customer Customer?        @relation(fields: [customerId], references: [id])
  soldBy   User             @relation("DirectSaleSoldBy", fields: [soldById], references: [id])
  items    DirectSaleItem[]

  @@index([branchId, soldAt])
  @@map("direct_sale")
}

model DirectSaleItem {
  id             String @id @default(cuid())
  saleId         String
  itemId         String
  itemName       String
  quantity       Int
  unitPricePaise Int
  totalPaise     Int

  sale DirectSale @relation(fields: [saleId], references: [id])
  item Item       @relation(fields: [itemId], references: [id])

  @@index([saleId])
  @@map("direct_sale_item")
}

// ─── Buyback ─────────────────────────────────────────────────────────────────

enum BuybackStatus {
  PENDING_ASSESSMENT
  SENT_FOR_REFURBISHMENT
  ADDED_TO_REFURB_STOCK
  SOLD
  SCRAPPED
}

model BuybackRecord {
  id               String        @id @default(cuid())
  branchId         String
  customerId       String?
  customerName     String
  customerPhone    String
  deviceName       String
  brand            String?
  deviceModel      String?
  condition        String        // e.g. "WORKING", "PARTIAL", "NOT_WORKING"
  agreedPricePaise Int
  status           BuybackStatus @default(PENDING_ASSESSMENT)
  notes            String?
  recordedById     String
  recordedAt       DateTime      @default(now()) @db.Timestamptz
  isActive         Boolean       @default(true)

  branch     Branch     @relation(fields: [branchId], references: [id])
  customer   Customer?  @relation(fields: [customerId], references: [id])
  recordedBy User       @relation("BuybackRecordedBy", fields: [recordedById], references: [id])
  refurbItem RefurbItem?

  @@index([branchId, recordedAt])
  @@map("buyback_record")
}

// ─── Refurbished stock ───────────────────────────────────────────────────────

enum RefurbStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model RefurbItem {
  id                String       @id @default(cuid())
  branchId          String
  buybackId         String?      @unique
  name              String
  brand             String
  specs             String
  grade             String       // "A" / "B" / "C"
  costPaise         Int
  sellingPricePaise Int
  warrantyMonths    Int          @default(36)
  serialNo          String?
  status            RefurbStatus @default(AVAILABLE)
  addedAt           DateTime     @default(now()) @db.Timestamptz
  isActive          Boolean      @default(true)

  branch  Branch         @relation(fields: [branchId], references: [id])
  buyback BuybackRecord? @relation(fields: [buybackId], references: [id])

  @@index([branchId, status])
  @@map("refurb_item")
}

// ─── Sales Targets ────────────────────────────────────────────────────────────

enum TargetPeriod {
  DAILY
  MONTHLY
  YEARLY
}

model SalesTarget {
  id          String       @id @default(cuid())
  branchId    String
  period      TargetPeriod
  year        Int
  month       Int?         // 1–12; null for YEARLY
  day         Int?         // 1–31; null for DAILY and MONTHLY
  targetPaise Int
  isActive    Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User?  @relation("SalesTargetCreatedBy", fields: [createdById], references: [id])

  @@unique([branchId, period, year, month, day])
  @@index([branchId, period, year])
  @@map("sales_target")
}

// ─── Chip-Level Lab ──────────────────────────────────────────────────────────

// External vendors used for chip-level outsourcing.
model ChipLabVendor {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  remarks     String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  createdBy  User?              @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?              @relation("VendorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  outsources ChipLabOutsource[]
  labCases   Case[]             @relation("CaseLabVendor")

  @@index([isActive])
  @@map("chip_lab_vendor")
}

// Tracks one outsourced repair to an external vendor. Append-only: a case that
// is outsourced multiple times gets multiple rows.
model ChipLabOutsource {
  id               String    @id @default(cuid())
  caseId           String
  vendorId         String
  sentAt           DateTime  @db.Timestamptz
  expectedReturnAt DateTime? @db.Timestamptz
  actualReturnAt   DateTime? @db.Timestamptz
  referenceNo      String?
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz

  case      Case          @relation(fields: [caseId], references: [id])
  vendor    ChipLabVendor @relation(fields: [vendorId], references: [id])
  createdBy User?         @relation("OutsourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@map("chip_lab_outsource")
}

// Master list of quality-check points verified during the lab QC stage.
model QcChecklistItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  createdBy User?             @relation("QcChecklistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?             @relation("QcChecklistUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  responses CaseQcResponse[]

  @@index([isActive])
  @@map("qc_checklist_item")
}

// One answer to one checklist point at a QC stage (branch QUALITY_CHECK or
// CHIP_LAB_QUALITY_CHECK). Never updated: re-saving stamps removedAt on the old
// rows and inserts new ones. A QC round counts only when answered after the
// case entered the stage (createdAt >= Case.stageChangedAt).
model CaseQcResponse {
  id              String     @id @default(cuid())
  caseId          String
  checklistItemId String
  stage           CaseStatus
  title           String // checklist wording when answered
  passed          Boolean
  remarks         String?
  answeredById    String?
  createdAt       DateTime   @default(now()) @db.Timestamptz
  removedAt       DateTime?  @db.Timestamptz

  case          Case            @relation(fields: [caseId], references: [id])
  checklistItem QcChecklistItem @relation(fields: [checklistItemId], references: [id])
  answeredBy    User?           @relation("QcResponseAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([caseId, stage, removedAt])
  @@map("case_qc_response")
}

// ─── AI Agents ────────────────────────────────────────────────────────────────

// Append-only log of every Kiran conversation turn.
model AiAgentRun {
  id         String   @id @default(cuid())
  agentName  String   // "kiran"
  userId     String
  branchId   String?  // null = all-branch scope
  question   String
  answer     String
  tokensUsed Int?
  durationMs Int?
  error      String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([userId, createdAt])
  @@index([agentName, createdAt])
  @@map("ai_agent_run")
}
