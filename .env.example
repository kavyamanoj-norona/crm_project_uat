# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL 16 connection string
DATABASE_URL="postgresql://postgres:Kavyasql%40123@localhost:5432/crm_project?schema=public"

# Secret used to sign the session cookie (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string-of-32-chars"

# Encrypts device passcodes stored on cases (min 32 chars). Never change it once
# data exists, or stored passcodes can no longer be read.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY="change-me-to-another-long-random-string-32"
