# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL 16 connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/laptop_clinic_crm?schema=public"

# Secret used to sign the session cookie (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string-of-32-chars"
